{
  "name": "matchtone",
  "version": "0.1.1",
  "description": "Open-source desktop photo color & tone matcher powered by color-matcher",
  "license": "GPL-3.0-or-later",
  "author": "gendonholaholo",
  "homepage": "https://github.com/gendonholaholo/MatchTone",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gendonholaholo/MatchTone.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "trustedDependencies": [
    "electron"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "preview:web": "vite preview src/renderer --outDir ../../out/renderer --host 127.0.0.1 --port 4173",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "pack": "bun run build && electron-builder --mac --dir",
    "dist:mac": "bun run build && electron-builder --mac"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
